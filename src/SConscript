import os
from building import *

# 显式构建变体；试验源码不进入正式应用组。
variant = os.environ.get('MAZE_BUILD_VARIANT', 'normal')
if variant not in ('normal', 'scrolling-trial'):
    raise ValueError('Unknown MAZE_BUILD_VARIANT: ' + variant)
src = Glob('*.c')
trial = ('maze_map_scroll_trial.c', 'maze_scroll_trial.c')
if variant == 'normal':
    src = [node for node in src if os.path.basename(str(node)) not in trial]
group = DefineGroup('Applications', src, depend=[''],
                    CPPDEFINES=['MAZE_SCROLL_TRIAL'] if variant == 'scrolling-trial' else [])
Return('group')

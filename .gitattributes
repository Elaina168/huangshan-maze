* text=auto
*.md text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.json text eol=lf
*.yml text eol=lf
.githooks/* text eol=lf
*.pdf binary
*.log -text
# 原始证据保留换行、行尾空格及末尾空行；源码和文档仍按默认规则检查。
evidence/**/*.log -text whitespace=-blank-at-eol,-blank-at-eof
evidence/**/serial-log.txt -text whitespace=-blank-at-eol,-blank-at-eof
# 原样导入文件保留实际字节及换行，避免跨平台归档破坏来源校验。
project/* -text
# 项目分区表保留已构建的CRLF字节，CR不作为多余行尾空白。
project/ptab.json -text whitespace=cr-at-eol
src/main.c -text
src/SConscript -text
LICENSE-SiFli-SDK-Apache-2.0.txt -text

# LVGL原始PPM像素与第三方许可保留原字节，不按源码检查行尾。
*.ppm binary
licenses/NotoSansSC-OFL.txt -text whitespace=-blank-at-eol,-blank-at-eof

# 构建证据保留SDK生成配置和下载脚本原字节及末尾空行。
evidence/builds/**/*.h -text whitespace=cr-at-eol
evidence/**/uart_download.bat -text whitespace=cr-at-eol,-blank-at-eof
